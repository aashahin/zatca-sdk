{
  "openapi": "3.0.1",
  "info": {
    "title": "e-Invoicing Sandbox Release (2.1.0)",
    "description": "ZATCA wants to provide Taxpayers and Developers of Taxpayer e-invoicing solutions and devices the opportunity to test the integration of the systems with a ZATCA Sandbox environment prior to the launch of the production system. The Integration Sandbox (ISB) should enable solution developers to simulate the integration calls/requests that will be required later as part of the registration process and the submission of e-invoices, credit and debit notes to the production system. The Sandbox backend will accordingly simulate the validations and responses as part of the Cryptographic Stamp Identifiers issuance, renewal and revocation as well as the Reporting and Clearance function. \n\n Although the ISB will give ZATCA an indication of the adoption rate for e-invoicing solutions in the market, it will not be mandatory to complete Sandbox testing as a pre-requisite for Registration/Taxpayer onboarding or accessing the production system. Similar to the Compliance and Enablement Toolbox (CET), the ISB is also aimed at Developers to build/update their solutions which are in line with ZATCA specifications and standards and are able to integrate with a ZATCA backend. Accordingly access to the ISB test/mock APIs will not be limited to Taxpayers and any user can register for a Developer account to access the ISB test/mock APIs and associated documentation. This registration will enable ZATCA to monitor the solution providers who intent to develop/update their solutions to integrate with ZATCA. \n\n It should be noted that although the ISB will simulate most of the core functionalities of the production system, any validations that require integrations/access with external systems and/or storage as well as scenarios involving any backend exceptional handling (for example overriding the clearance process) will not be part of the ISB and will be covered by the core solution. Accordingly the ISB should not be considered as representative of all integrations and/or APIs that will be part of the production system. \n\n This swagger documents the set of apis for the Sandbox (ISB) solution.\n\n Developers can also refer to section 2.3.10 of the Developer Portal User Manual for additional guidance and steps.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal"
    }
  ],
  "paths": {
    "/production/csids": {
      "patch": {
        "tags": [
          "Cryptographic Stamp Identifier (Certificate) Endpoint(s)"
        ],
        "summary": "Renews an X509 Certificate (CSID) based on submitted CSR.",
        "description": "Renews an X509 Certificate (CSID) based on submitted CSR",
        "operationId": "RenewCertificatesUsingPOST",
        "parameters": [
          {
            "name": "OTP",
            "in": "header",
            "description": "One time password generated from Fatoora portal",
            "required": true,
            "schema": {
              "type": "string"
            },
            "examples": {
              "invalidOTP": {
                "value": "111111",
                "summary": "Invalid OTP"
              },
              "expiredOTP": {
                "value": "222222",
                "summary": "Expired OTP"
              },
              "validOTP": {
                "value": "123456",
                "summary": "Valid OTP"
              }
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "description": "Specifies the langauge in which the response will be returned. Currently supported languages are English (en) and Arabic (ar) and it defaults to English.",
            "schema": {
              "type": "string"
            },
            "examples": {
              "english": {
                "value": "en",
                "summary": "English"
              },
              "arabic": {
                "value": "ar",
                "summary": "Arabic"
              }
            }
          },
          {
            "name": "Accept-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "value": "V2"
          }
        ],
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "requestBody": {
          "description": "CSR Request in body as Base64.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CSRRequest"
              },
              "example": {
                "csr": ""
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "returns a Base64 encoded X509 certificate",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "requestID": 347,
                  "tokenType": "http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-x509-token-profile-1.0#X509v3",
                  "dispositionMessage": "ISSUED",
                  "binarySecurityToken": "",
                  "secret": "1npmzeTq4VnKFQaZ5/9SwUxNhoLtuMWZVLVWUm3MTVU="
                }
              }
            }
          },
          "400": {
            "description": "HTTP Bad Request. Returned when the submitted request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificatesErrorsResponse"
                },
                "examples": {
                  "Missing OTP": {
                    "value": {
                      "errors": [
                        {
                          "code": "Missing-OTP",
                          "message": "OTP is required field"
                        }
                      ]
                    }
                  },
                  "Invalid OTP": {
                    "value": {
                      "errors": [
                        {
                          "code": "Invalid-OTP",
                          "message": "The provided OTP is invalid"
                        }
                      ]
                    }
                  },
                  "Missing CSR": {
                    "value": {
                      "errors": [
                        {
                          "code": "Missing-CSR",
                          "message": "CSR is required field"
                        }
                      ]
                    }
                  },
                  "Invalid CSR": {
                    "value": {
                      "errors": [
                        {
                          "code": "Invalid-CSR",
                          "message": "The provided CSR is invalid"
                        }
                      ]
                    }
                  },
                  "Missing currentCSID": {
                    "value": {
                      "errors": [
                        {
                          "code": "Missing-currentCSID",
                          "message": "currentCSID is required field"
                        }
                      ]
                    }
                  },
                  "Invalid currentCSID": {
                    "value": {
                      "errors": [
                        {
                          "code": "Invalid-currentCSID",
                          "message": "The provided currentCSID is invalid"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Returned when username and password are not added or added as wrong values.",
            "content": {
              "application/json": {
                "examples": {
                  "Unuthorized": {
                    "summary": "Unauthorized",
                    "value": {
                      "timestamp": 1654514661409,
                      "status": 401,
                      "error": "Unauthorized",
                      "message": ""
                    }
                  }
                }
              }
            }
          },
          "406": {
            "description": "Returned when accept version header is anything other than V2",
            "content": {
              "text/plain;charset=UTF-8": {
                "examples": {
                  "Not Acceptable": {
                    "summary": "Not Acceptable",
                    "value": "This Version is not supported or not provided in the header."
                  }
                }
              }
            }
          },
          "428": {
            "description": "returns a Base64 encoded X509 compliance certificate",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "value": {
                    "requestID": 1234567890123,
                    "tokenType": null,
                    "dispositionMessage": "NOT_COMPLIANT",
                    "binarySecurityToken": "",
                    "secret": "goDgeIdM5mkfTThl1unu8rP9XhknKWAc24hafXZS1f4=",
                    "errors": null
                  }
                }
              }
            }
          },
          "500": {
            "description": "HTTP Internal Server Error. Returned when the service faces internal errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                },
                "examples": {
                  "InternalServerError": {
                    "summary": "Internal Server Error",
                    "value": {
                      "category": "HTTP-Errors",
                      "code": "500",
                      "message": "Something went wrong and caused an Internal Server Error."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InfoModel": {
        "title": "InfoModel",
        "description": "An object representing the result of the clearance or reporting API endpoints when the clearance flag is turned on or off. Basically, it shows an informational message instructing the client to see the other api. ",
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorModel": {
        "title": "ErrorModel",
        "description": "An object representing the structure of the error object returned by the API endpoints. Specifically, it includes the Category of the error, its code and message.",
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "WarningModel": {
        "title": "WarningModel",
        "description": "An object representing the structure of the warning object returned by the API endpoints. Specifically, it includes the Category of the warning, its code and message.",
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "InvoiceResultModel": {
        "title": "InvoiceResultModel",
        "description": "An Object the represents the response of the API endpoint where it shows the results including status, warnings (if any), and error (if any) in addition to the submitted document hash",
        "type": "object",
        "properties": {
          "invoiceHash": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Reported",
              "Not Reported",
              "Accepted with Warnings"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WarningModel"
            }
          },
          "erros": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorModel"
            }
          }
        }
      },
      "ClearedInvoiceResultModel": {
        "title": "ClearedInvoiceResultModel",
        "description": "An object representing the structure of the clearance endpoint response. Specifically, it is an object that contains the hash of the document, status, the cleared document, warnings (if any), and errors (if any).",
        "type": "object",
        "properties": {
          "invoiceHash": {
            "type": "string"
          },
          "clearedInvoice": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Cleared",
              "Not Cleared"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WarningModel"
            }
          },
          "erros": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorModel"
            }
          }
        }
      },
      "InvoiceRequest": {
        "title": "InvoiceRequest",
        "description": "An object representing the structure of the clearance endpoint request. Specifically, it has the the submitted document hash and the base64 representation of the invoice.",
        "type": "object",
        "properties": {
          "invoiceHash": {
            "type": "string"
          },
          "invoice": {
            "type": "string"
          }
        }
      },
      "CSRRequest": {
        "title": "CSRRequest",
        "description": "An object representing the structure of the CSR request that is used to generate a CSID.",
        "properties": {
          "csr": {
            "type": "string"
          }
        }
      },
      "CertificatesErrorsResponse": {
        "title": "CertificatesErrorsResponse",
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorModel"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Usrename:  \n\n Password: epycRKns8eYW6i35KmPs3xga4A9z2pdBFK7UcMjJmG0="
      }
    }
  }
}